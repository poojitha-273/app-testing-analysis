{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx kill-port 3000 && tsx backend/server.ts",
    "build": "vite build frontend && esbuild backend/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:generate": "node tests/generate_exact_300_suites.js",
    "test:selenium": "node tests/selenium/run_selenium_tests.js",
    "test:appium": "node tests/appium/run_appium_tests.js",
    "test:load": "node tests/load/run_load_test.js",
    "test:all": "node tests/run_all_300_suites.js",
    "android:build": "cd mobile/android && gradlew assembleDebug --no-daemon && cd ../.. && copy mobile\\android\\app\\build\\outputs\\apk\\debug\\app-debug.apk BloodAI-debug.apk",
    "android:clean": "cd mobile/android && gradlew clean --no-daemon"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-native": "^0.76.0",
    "sql.js": "^1.14.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/selenium-webdriver": "^4.35.6",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "exceljs": "^4.4.0",
    "selenium-webdriver": "^4.46.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
